# ============================================================
# Supabase Cloud → AnalyticDB Supabase 迁移配置模板
# ============================================================
# 使用说明:
#   1. 复制此文件为 migration.env
#   2. 填写所有占位符
#   3. 执行: source migration.env (Git Bash) 或手动设置环境变量
# ============================================================

# ---- 源端: Supabase Cloud (新加坡区) ----
SOURCE_PROJECT_REF="bszkmteimqfnvovroikt"

# 从 Supabase Dashboard → Project Settings → API 获取
# Publishing API 中找 anon/public key (以 sb_publishable_ 开头)
SOURCE_ANON_KEY="sb_publishable_0OpBYuN5vvO2p6qiZ6N3_w_5zA2vfeD"

# 从 Supabase Dashboard → Project Settings → API 获取
# 在 Project API Keys 中找 service_role key (以 eyJ 开头)
SOURCE_SERVICE_ROLE_KEY="<填写你的 service_role key>"

# 从 Supabase Dashboard → Connect → Connection String → Transaction pooler
# 格式: postgres://postgres.<project_ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SOURCE_DATABASE_URL="<填写 Transaction pooler 连接串>"

# ---- 目标端: AnalyticDB Supabase (阿里云) ----
# 在阿里云控制台 → AnalyticDB PostgreSQL → Supabase → 项目详情页获取

# 完整 API 地址, 例如 https://xxx.supabase.opentrust.net
TARGET_API_URL="<填写目标 API URL>"

# 匿名密钥 (以 eyJ 开头)
TARGET_ANON_KEY="<填写目标 anon key>"

# 服务角色密钥 (以 eyJ 开头)
TARGET_SERVICE_ROLE_KEY="<填写目标 service role key>"

# PostgreSQL 连接串
# 格式: postgres://postgres:<password>@<instance-id>.supabase.opentrust.net:5432/postgres
TARGET_DATABASE_URL="<填写目标数据库连接串>"
