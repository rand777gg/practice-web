# SUPABASE
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# AI
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_QWEN_API_KEY=your_dashscope_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# Cloudflare Turnstile (bot protection for login/register)
VITE_CF_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Secret key is set via Supabase Dashboard → Edge Functions → cloudflare-turnstile → Secrets
# CF_TURNSTILE_SECRET=your_turnstile_secret_key

# Edge Functions: r2-upload, r2-image (Supabase Dashboard → Edge Functions → Settings)
# R2 credentials
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=practice-web
R2_PUBLIC_URL=https://r2-rpw.pguide.dev
# SUPABASE_URL is auto-set by Supabase, no need to add manually
