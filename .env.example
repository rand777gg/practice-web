# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Web Push (VAPID) —— 预约考试到点手机/桌面推送
# 生成: node scripts/generate-vapid.mjs(写入 .env 并打印公钥/私钥)
# VITE_ 前缀的只会被打进前端包; 私钥请再粘贴到 Supabase Edge Function Secrets
VITE_VAPID_PUBLIC_KEY=your_urlsafe_base64_public_key
# VAPID_PRIVATE_KEY=your_urlsafe_base64_private_key   (仅 .env, 勿提交)
# VAPID_SUBJECT=mailto:admin@example.com              (仅 .env, 勿提交)

# AI —— 注意: 平台的模型调用全部走 Edge Function 代理(supabase/functions/ai),
# Key 只存在 Supabase secret, **不要**再放到前端变量里: VITE_ 前缀是构建期内联的,
# 谁打开产物谁就能把 Key 抠走(线上就这么泄过一次)。
# 部署 AI 相关能力时需要设置的 secret:
#   supabase secrets set DEEPSEEK_API_KEY=<你的 deepseek key>   # ai 代理 + parse-paper-cover
#   supabase secrets set QWEN_API_KEY=<你的 dashscope key>       # rag-search 算查询向量
# 可选: DEEPSEEK_BASE_URL (默认 https://api.deepseek.com), DEEPSEEK_VISION_MODEL
# 前端只保留模型名(不是秘密):
VITE_DEEPSEEK_MODEL=deepseek-chat

# Edge Functions: r2-upload, r2-image (Supabase Dashboard → Edge Functions → Settings)
# R2 credentials
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://r2.example.com
# 前端也要知道这个域名(缩略图、R2 PDF 去重、Markdown 图片都靠它拼地址), 不带协议。
# 必须与 Edge Function 的 R2_PUBLIC_HOST secret 填同一个值: 域名换了只改这两处。
# 域名失效的表现是"图片不显示、MinerU 解析失败", 不会有别的报错, 所以别忘了改。
VITE_R2_PUBLIC_HOST=r2.example.com
# SUPABASE_URL is auto-set by Supabase, no need to add manually

# Edge Function: mineru-proxy / parse-paper-cover (资料库精确解析、AI 导题 OCR、试卷封面)
# MinerU token 也只在服务端了 —— 前端不带 X-MinerU-Token 时由 mineru-proxy 补上平台的。
# 使用者想走自己的额度, 可以在 AI 设置页填一把, 那份只存他自己的浏览器。
#   supabase secrets set MINERU_TOKEN=<你的 mineru token>
#   supabase secrets set DEEPSEEK_API_KEY=<你的 deepseek key>
# 可选: DEEPSEEK_BASE_URL (默认 https://api.deepseek.com), DEEPSEEK_VISION_MODEL (默认 deepseek-v4-flash-vision-exp)

# TTS 朗读 (错题页 / 知识点解读的"朗读"按钮)
# 自建 edge-tts worker, 接口兼容 OpenAI: POST /v1/audio/speech { input, voice, speed, pitch, style }
# 不填则用 src/lib/tts/config.ts 里的默认地址
VITE_TTS_BASE_URL=https://tts.example.com

# 扫码登录 / WebAuthn 的站点白名单(manage-passkey 用): 必须是**正式站**的来源, 不能取请求里的 Origin。
# SITE_URL 同时被 qr-login / notify-exam / study-room 用来拼回跳与邮件里的链接
#   supabase secrets set SITE_URL=https://your-app.example.com
